# Enforce Unix LF endings for Linux server scripts and service definitions
deployment/scripts/*.sh text eol=lf
deployment/scripts/*.py text eol=lf
deployment/systemd/*.service text eol=lf
deployment/nginx/*.conf text eol=lf
deployment/logrotate/* text eol=lf
deployment/env.production.example text eol=lf
scripts/*.py text eol=lf

