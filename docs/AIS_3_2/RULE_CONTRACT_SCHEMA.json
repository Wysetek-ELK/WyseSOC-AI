{
  "$defs": {
    "ContractApprovalState": {
      "enum": [
        "PROVISIONAL",
        "APPROVED",
        "DRAFT",
        "REVOKED"
      ],
      "title": "ContractApprovalState",
      "type": "string"
    },
    "RuleConditionClause": {
      "properties": {
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "logical_op": {
          "default": "AND",
          "title": "Logical Op",
          "type": "string"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        },
        "nested_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nested Group"
        },
        "evaluation_status": {
          "default": "UNKNOWN",
          "title": "Evaluation Status",
          "type": "string"
        },
        "observed_values": {
          "items": {
            "type": "string"
          },
          "title": "Observed Values",
          "type": "array"
        }
      },
      "required": [
        "attribute",
        "operator",
        "expected"
      ],
      "title": "RuleConditionClause",
      "type": "object"
    }
  },
  "description": "Complete typed contract for universal rule-aware verdict intelligence (AIS 3.2).",
