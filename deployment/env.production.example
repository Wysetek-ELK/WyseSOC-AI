# ==============================================================================
# AI VERDICT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to /opt/ai-verdict/backend/.env with 0600 permissions:
#   chmod 600 /opt/ai-verdict/backend/.env
#   chown aiverdict:aiverdict /opt/ai-verdict/backend/.env
#
# IMPORTANT: All production deployments strictly validate SECRET_KEY (AV-014).
# Insecure or default values will immediately abort application startup.
# Generate cryptographically secure keys with: openssl rand -hex 32
# ==============================================================================

# Application Environment & Separated Operating Mode
# Valid modes: development | integration | shadow | advisory | autonomous
# Production deployments must NEVER use 'development'. Recommended: advisory (or shadow).
APP_ENV="production"
PLATFORM_OPERATING_MODE="advisory"
PROJECT_NAME="AI Verdict"
VERSION="1.0.0"

# Cryptographic Authentication & Session Security (Minimum 32 characters required)
SECRET_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32_MINIMUM_32_CHARACTERS"
AUDIT_SIGNING_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32_FOR_HMAC_AUDIT_SIGNATURES"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="480"
COOKIE_SECURE="true"
COOKIE_SAMESITE="lax"

# Server 1 PostgreSQL Database Configuration (Connection Pooling Hardened)
DATABASE_URL="postgresql+asyncpg://aiverdict_user:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/ai_verdict"
SYNC_DATABASE_URL="postgresql+psycopg2://aiverdict_user:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/ai_verdict"
DB_POOL_SIZE="20"
DB_MAX_OVERFLOW="10"
DB_POOL_TIMEOUT="30.0"
DB_POOL_RECYCLE="1800"
AUTO_MIGRATE_ON_STARTUP="false"

# Distributed Asynchronous Task Queue (Celery / Redis)
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"
USE_ASYNC_CELERY="true"
CELERY_TASK_TIMEOUT_SECONDS="300"

# Server 2 Local GPU Inference Integration (vLLM / OpenAI-Compatible over private VLAN)
LOCAL_LLM_BASE_URL="http://REPLACE_WITH_SERVER2_PRIVATE_HOST:8000/v1"
LOCAL_LLM_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct-AWQ"
LOCAL_LLM_API_KEY="EMPTY"
LOCAL_LLM_TIMEOUT="60.0"
# Context budget options: 4096 (default) or 8192 (validated only when Server 2 vLLM --max-model-len >= 8192)
LOCAL_LLM_CONTEXT_BUDGET="4096"
LOCAL_LLM_MAX_TOKENS="512"
LOCAL_LLM_ALLOW_MOCK_FALLBACK="false"

# Concurrency & GPU Overload Circuit Breaker
LLM_MAX_CONCURRENT_REQUESTS="4"
LLM_CIRCUIT_BREAKER_FAIL_THRESHOLD="5"
LLM_CIRCUIT_BREAKER_RECOVERY_TIME="30.0"
QUEUE_BACKPRESSURE_LIMIT="1000"

# FortiSIEM Integration (Optional Production Ingestion — Read-Only)
FORTISIEM_HOST=""
FORTISIEM_USERNAME=""
FORTISIEM_PASSWORD=""
FORTISIEM_VERIFY_SSL="true"
FORTISIEM_TIMEOUT="25.0"
FORTISIEM_MOCK_FALLBACK="false"
FORTISIEM_AUTO_POLL_ENABLED="false"
FORTISIEM_POLL_INTERVAL_SECONDS="180"
FORTISIEM_AUTO_AI_VERDICT="true"
