[Unit]
Description=AI Verdict FastAPI Backend Application Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=aiverdict
Group=aiverdict
WorkingDirectory=/opt/ai-verdict/backend
EnvironmentFile=/opt/ai-verdict/backend/.env
ExecStart=/opt/ai-verdict/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5s
LimitNOFILE=65535
StandardOutput=append:/var/log/ai-verdict/backend.log
StandardError=append:/var/log/ai-verdict/backend-error.log

[Install]
WantedBy=multi-user.target

